# InvestAI Environment Variables
# Copy to .env and fill with your actual values
# NOTE: Never commit .env to version control

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=your_password_here
DB_NAME=investai
# true apenas para bancos em nuvem que exigem SSL (ex: TiDB Serverless).
# XAMPP local e o MySQL do Railway normalmente devem ficar como false.
DB_SSL=false

# AI APIs
# AI_PROVIDER controla qual IA é usada: "ollama" (local, dev) ou "gemini" (produção/deploy).
# Deixe em branco ou "gemini" no Railway/produção. Use "ollama" no seu .env local.
AI_PROVIDER=gemini
GEMINI_API_KEY=your-api-key-here
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:latest
OLLAMA_TIMEOUT=120

# Gemini Configuration
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_TIMEOUT=35

# Financial Alerts
BUDGET_ALERT_THRESHOLD=80
OVERSPEND_PRIORITY_THRESHOLD_HIGH=150
OVERSPEND_PRIORITY_THRESHOLD_MEDIUM=100

# Logging
LOG_PATH=logs

# Token para autenticar chamadas internas ao processador de notícias por HTTP
CRON_TOKEN=generate_a_random_secret_here

# Admin
ADMIN_EMAIL=your_admin_email_here
ADMIN_PASSWORD=your_admin_password_here

# App URL (usada para montar links, ex: e-mail de recuperação de senha)
# Em produção, defina como a URL pública do site (ex: https://seuapp.up.railway.app)
APP_URL=http://localhost/inventai

# SMTP (envio de e-mail — recuperação de senha). Deixe em branco para desativar o envio.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user_here
SMTP_PASS=your_smtp_password_or_app_password_here
SMTP_FROM=your_smtp_user_here
SMTP_FROM_NAME=InvestAI
SMTP_SECURE=tls

# Dashboard de testes (/test) — executor Robot Framework (ver tests-robot/README.md).
# Deixe em branco em produção: sem executor, o dashboard fica somente informativo.
TEST_RUNNER_URL=
TEST_RUNNER_TOKEN=
