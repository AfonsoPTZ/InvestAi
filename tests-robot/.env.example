# Configuração dos testes Robot Framework — copie para tests-robot/.env
# Nunca versione o .env com credenciais reais.

# local | homolog | production
# Em "production" o usuário de teste NÃO é criado e testes de escrita são pulados.
ROBOT_ENV=local

# URL-base da aplicação.
#   Terminal (venv) com o docker-compose rodando: http://localhost:8080
#   Executor dentro do docker-compose: definido no docker-compose.yml (http://investai-web)
ROBOT_BASE_URL=http://localhost:8080

# Usuário de teste dedicado (nunca use uma conta real).
ROBOT_USER_NAME=Usuario Teste Robot
ROBOT_USER_EMAIL=robot.teste@investai.local
ROBOT_USER_PASSWORD=troque-esta-senha

# true: cadastra o usuário de teste via API se ele não existir (ignorado em production)
ROBOT_CREATE_TEST_USER=true
# true: habilita o teste que cria e exclui uma despesa (ignorado em production)
ROBOT_ALLOW_WRITE=true

ROBOT_BROWSER=chromium
ROBOT_HEADLESS=true
ROBOT_TIMEOUT=10s

# Executor (runner/server.py)
RUNNER_MAX_SECONDS=300
RUNNER_KEEP_RUNS=20
