Options -Indexes
DirectoryIndex index.php

# Remove qualquer Content-Security-Policy injetado pelo Apache global
Header always unset Content-Security-Policy
Header always unset X-Content-Security-Policy

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Dashboard de testes automatizados (acesso restrito ao admin, ver testes.php)
    RewriteRule ^test/?$ frontend/public/pages/admin/testes.php [L,QSA]
</IfModule>

# Bloquear acesso via HTTP a arquivos sensíveis (segredos, config, dados, controle de versão)
<FilesMatch "(^\.env|^\.env\..*|\.sql$|\.log$|composer\.(json|lock)$|\.gitignore$|README\.md$)">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteRule ^\.git - [F,L]
</IfModule>
